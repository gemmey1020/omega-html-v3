{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.invalid/schemas/raw/root.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "omega": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "3.0"
        }
      },
      "required": ["schema"]
    },
    "kind": {
      "type": "string",
      "const": "artifact"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://omega.invalid/schemas/common/id.schema.json"
        }
      }
    },
    "spec": {
      "$ref": "https://omega.invalid/schemas/raw/artifact.schema.json"
    }
  },
  "required": ["omega", "kind", "spec"]
}
